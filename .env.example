# --- API ---
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
# Generate with: openssl rand -hex 32
SECRETS_KEY=
PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# --- Optional: AI generation (template fallback when empty) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional: OAuth (returns 501 when empty) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Internal SPA scanner ---
SPA_SCANNER_URL=http://spa-scanner:8090
SPA_SCANNER_TOKEN=
SPA_SCANNER_ENABLED=false

# --- Isolated SPA scanner profile (disabled by default) ---
SCANNER_ALLOWED_HOSTS=
EGRESS_PROXY_USERNAME=
EGRESS_PROXY_PASSWORD=

# --- Isolated Playwright QA runner ---
QA_RUNNER_TOKEN=
